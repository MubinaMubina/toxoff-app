# Copy to .env and fill in. Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# RevenueCat: App Store subscriptions. Only the public Apple key (appl_...) goes here; the secret key
# is a backend secret (README > App Store subscriptions). Blank = purchases run in demo mode.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_KEY

# The backend (supabase/functions/api): Instagram connect, restores, subscriptions
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
