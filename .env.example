# Copy to .env and fill in. Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Stripe — rest-of-world billing (publishable key only on the client; secret key lives on your server)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# Safepay — Pakistan billing (cards + JazzCash + Easypaisa). Secret key stays on the server.
EXPO_PUBLIC_SAFEPAY_PUBLIC_KEY=sec_YOUR_SAFEPAY_PUBLIC_KEY
EXPO_PUBLIC_SAFEPAY_ENVIRONMENT=sandbox

# Google OAuth (for Supabase Google sign-in via expo-auth-session)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# The backend (supabase/functions/api): Instagram connect, restores, billing sessions
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
