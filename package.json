{
  "name": "toxoff",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:ui": "node --test scripts/web-crypto.test.cjs scripts/password-recovery.test.cjs scripts/oauth-callback.test.cjs scripts/auth-recovery.test.cjs scripts/protection.test.cjs scripts/theme-contrast.test.cjs",
    "test:functions": "deno test --allow-env --config supabase/functions/api/deno.json supabase/functions/tests",
    "test:security": "deno test --allow-env --config supabase/functions/api/deno.json supabase/functions/tests/security_store_test.ts && node --test scripts/security-invites.test.cjs",
    "test:db": "node --test scripts/security-invites.test.cjs scripts/freemium.test.cjs",
    "gen:assets": "node scripts/generate-assets.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.5",
    "@supabase/supabase-js": "^2.46.1",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.0",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.3",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.11",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-tracking-transparency": "~5.1.1",
    "expo-web-browser": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-google-mobile-ads": "^14.11.0",
    "react-native-purchases": "^10.9.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  },
  "private": true
}
